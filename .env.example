# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real passwords or API keys.

# --- PostgreSQL owner account (used only to create tables and load data) ---
POSTGRES_DB=business_analytics
POSTGRES_USER=analytics_admin
POSTGRES_PASSWORD=change_me_admin

# --- Read-only account (used by the dashboard and the AI workflow) ---
RO_DB_USER=analytics_ro
RO_DB_PASSWORD=change_me_readonly

# --- Ports on your Mac ---
APP_PORT=8501
DB_HOST_PORT=5433

# --- LLM provider (needed only for the AI Business Analyst page) ---
# LLM_PROVIDER: anthropic or openai
LLM_PROVIDER=anthropic
# Leave empty for the default model, or set e.g. claude-sonnet-5-5 / gpt-4o-mini
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Limits ---
AI_MAX_ROWS=200
AI_MAX_RETRIES=2
STATEMENT_TIMEOUT_MS=5000
LOW_STOCK_THRESHOLD=15
